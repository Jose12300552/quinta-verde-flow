@startuml Componentes_SARQUE
skinparam backgroundColor #FFFFFF
skinparam component {
  BackgroundColor #E8F5E9
  BorderColor #2E7D32
  ArrowColor #424242
}
skinparam database {
  BackgroundColor #E3F2FD
  BorderColor #1565C0
}
skinparam cloud {
  BackgroundColor #FFF3E0
  BorderColor #E65100
}
skinparam node {
  BackgroundColor #F3E5F5
  BorderColor #6A1B9A
}
skinparam shadowing false

title <b>Diagrama de Componentes — SARQUE</b>

node "Cliente Web (Navegador)" as Cliente {
  component "App Web SARQUE\n(React + TypeScript + Vite)" as App
  component "Tailwind + shadcn/ui" as UI
  component "React Query" as RQ
  component "Zod\n(validación)" as Zod
  App --> UI
  App --> RQ
  App --> Zod
}

cloud "Supabase (Nube)" as Supabase {
  component "Supabase Auth\n(JWT)" as Auth
  database "PostgreSQL\n+ Row Level Security" as DB
  component "REST API\n(PostgREST)" as API
  API --> DB
  Auth --> DB
}

node "Smartphone Administrador" as Phone {
  component "App K-RainBL\n(K-Rain oficial)" as KApp
}

node "Sectores del Parque" as Parque {
  component "6 Controladores\nK-Rain BL-KR\n(2 BL-KR2 + 3 BL-KR4 + 1 BL-KR6)" as BLKR
  component "22 Electroválvulas\nBSPT 9V DC" as EV
  BLKR --> EV : pulso DC
}

App --> API : HTTPS/REST
App --> Auth : Login JWT
KApp ..> BLKR : Bluetooth Low Energy

note bottom of Cliente : Plataforma de gestión\ny documentación digital
note bottom of Phone : Control efectivo de\nlos riegos automáticos
@enduml
