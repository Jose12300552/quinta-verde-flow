@startuml CasosDeUso_SARQUE
skinparam backgroundColor #FFFFFF
skinparam actor {
  BackgroundColor #E3F2FD
  BorderColor #1976D2
}
skinparam usecase {
  BackgroundColor #FFF3E0
  BorderColor #F57C00
  ArrowColor #424242
}
skinparam packageStyle rectangle
skinparam shadowing false

title <b>Diagrama de Casos de Uso — Plataforma SARQUE</b>\n<i>Sistema Automatizado de Riego — Parque Quinta Estación</i>

left to right direction

actor "Administrador\n(Eliana Soria)" as Admin
actor "Operador\n(Jardinero)" as Op
actor "App K-RainBL" as KApp <<app externa>>
actor "Controlador\nBL-KR" as BLKR <<dispositivo>>

rectangle "Plataforma Web SARQUE" {
  usecase "CU01\nIniciar sesión" as CU01
  usecase "CU02\nVer cronograma\nsemanal" as CU02
  usecase "CU03\nGestionar\nsectores" as CU03
  usecase "CU04\nGestionar\ncontroladores" as CU04
  usecase "CU05\nDefinir horario\nde riego" as CU05
  usecase "CU06\nActivar/desactivar\nhorario" as CU06
  usecase "CU07\nConsultar manual\nde usuario" as CU07
  usecase "CU08\nGestionar\nusuarios" as CU08
}

Admin --> CU01
Admin --> CU02
Admin --> CU03
Admin --> CU04
Admin --> CU05
Admin --> CU06
Admin --> CU07
Admin --> CU08

Op --> CU01
Op --> CU02
Op --> CU07

CU02 ..> CU01 : <<include>>
CU03 ..> CU01 : <<include>>
CU05 ..> CU01 : <<include>>

Admin ..> KApp : programa\nBL-KR
KApp ..> BLKR : Bluetooth\n(BLE)

@enduml
